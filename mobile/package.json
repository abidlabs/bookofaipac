{
  "name": "scanaipac",
  "version": "1.0.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "npx expo start",
    "start:devclient": "bash scripts/expo-devclient-lan.sh",
    "start:tunnel": "env -u CI npx expo start --dev-client --host tunnel",
    "bundle-data": "node scripts/bundle-data.js",
    "prebuild": "node scripts/bundle-data.js && npx expo prebuild",
    "build:ios": "npx eas-cli build --profile development --platform ios",
    "build:android": "npx eas-cli build --profile development --platform android",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.0",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-text-extractor": "^2.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.10",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
